{
  "expo": {
    "name": "TrialGuard",
    "slug": "trialguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trialguard.app"
    },
    "android": {
      "package": "com.trialguard.app"
    },
    "web": {
      "build": {
        "babel": {
          "include": [
            "firebase"
          ]
        }
      }
    }
  }
}
